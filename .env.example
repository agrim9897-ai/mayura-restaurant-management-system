# Root / Backend Environment Variables Example
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mayura_db?schema=public"

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# JWT Authentication (for future features)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email SMTP (Gmail)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
