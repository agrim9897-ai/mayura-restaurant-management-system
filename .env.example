# Root / Backend Environment Variables Example
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mayura_db?schema=public"

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# JWT Authentication (for future features)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password
