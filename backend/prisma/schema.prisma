generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                   String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name                 String
  email                String    @unique
  password             String
  phone                String?   @default("+91 98765 00000")
  avatarUrl            String?
  role                 String    @default("Admin")
  status               String    @default("Active")
  lastLogin            DateTime?
  emailNotifications   Boolean   @default(true)
  reservationNotifs    Boolean   @default(true)
  preferredLanguage    String    @default("English (US)")
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
}

model Table {
  id           String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  tableNumber  String        @unique
  capacity     Int
  location     TableLocation @default(INDOOR)
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Reservation {
  id                String            @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name              String
  email             String
  phone             String
  reservationDate   DateTime
  reservationTime   String
  guests            Int
  occasion          String?
  seatingPreference String?
  status            ReservationStatus @default(PENDING)
  tableId           String?
  createdAt         DateTime          @default(now())
  table             Table?            @relation(fields: [tableId], references: [id])

  @@index([tableId])
}

model MenuCategory {
  id    String     @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name  String
  items MenuItem[]
}

model MenuItem {
  id               String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  categoryId       String
  name             String
  description      String?
  price            Float
  isVeg            Boolean      @default(false)
  imageUrl         String?
  videoUrl         String?
  videoId          String?
  videoDescription String?
  videoAspectRatio String?      @default("16:9")
  isAvailable      Boolean      @default(true)
  isFeatured       Boolean      @default(false)
  prepTime         String?      @default("15-20 mins")
  createdAt        DateTime     @default(now())
  category         MenuCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model ContactMessage {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model RestaurantSettings {
  id                     String  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  restaurantName         String  @default("Mayura Fine Cuisine")
  tagline                String? @default("Authentic Royal Indian Dining")
  description            String? @default("An extraordinary culinary journey blending royal Indian heritage with modern gastronomy.")
  logoUrl                String?
  phone                  String? @default("+91 98765 43210")
  email                  String? @default("contact@mayurafinecuisine.com")
  address                String? @default("Plot 42, Executive Enclave, Golf Course Road, Gurgaon, Haryana 122002")
  openingTime            String? @default("11:00 AM")
  closingTime            String? @default("11:30 PM")
  weekendHours           String? @default("11:00 AM - 12:00 AM")
  instagram              String? @default("https://instagram.com/mayurafinecuisine")
  facebook               String? @default("https://facebook.com/mayurafinecuisine")
  twitter                String? @default("https://twitter.com/mayura_cuisine")
  tripadvisor            String? @default("https://tripadvisor.com/mayura")
  maxGuestsPerTable      Int?    @default(12)
  reservationNoticeHours Int?    @default(2)
  advanceBookingDays     Int?    @default(30)
  heroTitle              String? @default("Taste of Royal Heritage")
  heroSubtitle           String? @default("Experience extraordinary flavors crafted with passion, tradition, and culinary artistry.")
  heroImageUrl           String?
  footerCopyright        String? @default("© 2026 Mayura Fine Cuisine. All rights reserved.")
  footerAbout            String? @default("Mayura Fine Cuisine represents the pinnacle of royal Indian dining, offering authentic recipes crafted with finest ingredients.")
}

enum TableLocation {
  INDOOR
  OUTDOOR
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Product {
  id               String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  title            String
  description      String?
  category         String?  @default("General")
  price            Float?   @default(0)
  imageUrl         String?
  images           String[] @default([])
  videoUrl         String?
  videoId          String?
  videoDescription String?
  videoAspectRatio String?  @default("16:9")
  specifications   String?
  isAvailable      Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

